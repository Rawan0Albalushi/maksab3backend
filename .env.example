APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:/NC6CNBiDJb2vV4fRviEsMqy5gKbePRgk44JGkZFAYY=
APP_DEBUG=true
APP_URL=http://localhost
APP_MODE=dev

# Behind a load balancer / Cloudflare / nginx that terminates HTTPS, set this so
# the app sees the original https scheme and host; otherwise generated URLs are
# http:// and the browser blocks the panel's ajax calls as mixed content.
# "*" trusts whatever proxy connects; or list IPs/CIDRs, comma-separated.
# TRUSTED_PROXIES=*

# Append translation keys that translate() cannot find to the current locale's
# messages.php. Handy while authoring; costly at runtime (each append rewrites
# the whole ~850 KB file and evicts it from OPcache), so it defaults to on only
# when APP_ENV is not production. Set explicitly to override.
# COLLECT_TRANSLATION_KEYS=false

# The single hostname where the admin/vendor panel + all host routes live.
# Sub-domains and custom domains in tenant_domain_configs serve the
# storefront at root. Leave both unset for single-tenant / legacy installs.
APP_HOST_DOMAIN=
APP_HOST_BASE_DOMAIN=
APP_PUBLIC_IP=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=multi_food_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
APP_CACHE_STORE=file
APP_CACHE_MAX_PAGE=3

QUEUE_CONNECTION=database
NOTIFICATION_MODE=after_response
NOTIFICATION_QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

REVERB_APP_ID=6ammart
REVERB_APP_KEY=6ammart
REVERB_APP_SECRET=6ammart
REVERB_HOST="${APP_URL}"
REVERB_PORT=6001
REVERB_SCHEME=http

PUSHER_APP_ID=6ammart
PUSHER_APP_KEY=6ammart
PUSHER_APP_SECRET=6ammart
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST="${APP_URL}"
PUSHER_PORT=6001
PUSHER_SCHEME=http

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

OPENAI_API_KEY=
OPENAI_ORGANIZATION=
SOFTWARE_VERSION=3.9
SOFTWARE_ID=MzY3NzIxMTI=
